{
  "name": "resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --force",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,json}\" \"scripts/**/*.mjs\" \"*.{ts,js,json,md,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,json}\" \"scripts/**/*.mjs\" \"*.{ts,js,json,md,html}\"",
    "generate:previews": "node scripts/generate-project-previews.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "aos": "^2.3.4",
    "i18next": "^23.4.6",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.0.0",
    "react-scroll": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^20.19.11",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.24",
    "@types/react-scroll": "^1.8.10",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^5.0.0",
    "globals": "^16.3.0",
    "playwright": "^1.58.2",
    "prettier": "^3.6.2",
    "sass": "^1.103.1",
    "sharp": "^0.35.3",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.39.1"
  },
  "description": "Personal resume / portfolio site of Danila Kulinkovich.",
  "homepage": "https://kulick23.github.io/resume/"
}
